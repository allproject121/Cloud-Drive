<UserControl x:Class="CloudSSD.Desktop.Views.MobileHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,24">

            <!-- Top Banner Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="18" Padding="10,4" Margin="0,0,10,0"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{Binding StatusTone, Converter={StaticResource Tone}}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                         Fill="{Binding StatusTone, Converter={StaticResource Tone}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" />
                            </StackPanel>
                        </Border>
                        <Button Content="Start Bridge" Command="{Binding ToggleServerCommand}" Padding="12,6"
                                Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=invert}"
                                Style="{StaticResource Primary}" />
                        <Button Content="Stop Bridge" Command="{Binding ToggleServerCommand}" Padding="12,6"
                                Visibility="{Binding IsRunning, Converter={StaticResource Vis}}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mobile Hub (Offline Phone Bridge)" Style="{StaticResource H2}" Margin="0,0,0,4" />
                        <TextBlock Text="Connect your Android phone over zero-data local Wi-Fi or hotspot for fast 4K streaming, file drop and game saves."
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Section strip: one thing at a time instead of everything on one long page. Each section below is shown
                 while its button here is selected. -->
            <Border Background="{DynamicResource Surface2}" CornerRadius="20" Padding="4" Margin="0,0,0,14">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="TabConnect" Content="Connect Phone" IsChecked="True" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabDevices" Content="Paired Devices" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabHistory" Content="Transfer History" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabSend" Content="Send to Phone" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabStorage" Content="Storage Saver" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabPermissions" Content="Permissions" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <RadioButton x:Name="TabFolders" Content="Folders" Style="{StaticResource PillRadio}" Height="34"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </UniformGrid>
            </Border>

            <!-- 1. Connect Phone: QR code, pairing code, address -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabConnect, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="New Code" Command="{Binding RegenerateTokenCommand}" Padding="8,4" FontSize="11" Margin="12,0,0,0"
                                    ToolTip="Make a new pairing code and QR code. Phones that are already paired keep working." />
                            <TextBlock Text="SCAN QR CODE WITH PHONE" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- QR Code Box -->
                        <Border Width="220" Height="220" Background="White" CornerRadius="14" HorizontalAlignment="Left"
                                Padding="10" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <Image Source="{Binding QrCode}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- Pairing code for the Android app (typed once; the QR code is for a phone's browser) -->
                        <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="12,10" Margin="0,0,0,14"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PAIRING CODE FOR THE PHONE APP" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PairingCode}" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                <TextBlock Text="Phone app me 'Connect to PC' dabao aur ye 6 number daalo. Ek baar use hone ke baad code badal jaata hai."
                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ONE-TIME PAIRING LINK (QR CODE · 10 MINUTES)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PairingUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10"
                                 FontFamily="Consolas" FontSize="11.5" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Copy Link" Command="{Binding CopyUrlCommand}" Padding="12,5" Margin="0,0,8,0" />
                            <Button Content="Open in Browser" Command="{Binding OpenInBrowserCommand}" Padding="12,5" />
                        </StackPanel>

                        <!-- Hotspot Tip Box -->
                        <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 NO WI-FI ROUTER / BROADBAND?" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Accent}" Margin="0,0,0,4" />
                                <TextBlock Text="Turn on your phone's Wi-Fi Hotspot and connect your PC to it. Mobile Internet Data ON karne ki bilkul zaroorat nahi hai. Local Wi-Fi transfer speed 50-100 MB/s milegi!"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Dim}" LineHeight="16" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Paired Devices -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabDevices, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Revoke All" Command="{Binding RevokeAllCommand}" Padding="8,3" FontSize="11" />
                        <TextBlock Text="PAIRED DEVICES" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Phones paired before per-phone keys still use the one shared key until it is turned off. -->
                    <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="12,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                            Visibility="{Binding LegacyKeyOn, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Turn off old key" Command="{Binding RetireLegacyKeyCommand}" Padding="10,4" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center">
                                <Run Text="The old shared key is still on" FontWeight="SemiBold" />
                                <Run Text="{Binding LegacyPhones, Mode=OneWay, StringFormat=' ({0} phone(s) still use it).'}" />
                                <Run Text="Updated phone apps switch to their own key by themselves; then turn the old key off." Foreground="{DynamicResource Dim}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- The device list lives on its own page now: cards with online now, connection and activity. -->
                    <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="14,12"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Open Devices" Command="{Binding OpenDevicesCommand}"
                                    Padding="12,6" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Text="Paired devices now have their own page: who is online and what they are doing."
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Transfer History -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabHistory, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TransferRateFormatted}" FontWeight="Bold"
                                   FontSize="13" Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="LIVE ACTIVITY &amp; TRANSFER HISTORY" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Action Bar: Count, Clear -->
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Clear History" Command="{Binding ClearTransferHistoryCommand}" Padding="8,3" FontSize="11" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Records:" FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Surface2}" CornerRadius="16" Padding="8,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding TotalTransferCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter Chips and Search -->
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <TextBox DockPanel.Dock="Right" Width="220" Text="{Binding TransferSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="6,3" ToolTip="Search transfers by name or device" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All"
                                    Padding="9,3" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="&#x2193; Received" Command="{Binding SetFilterCommand}" CommandParameter="Received"
                                    Padding="9,3" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="&#x2191; Sent" Command="{Binding SetFilterCommand}" CommandParameter="Sent"
                                    Padding="9,3" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="&#x25BA; Stream" Command="{Binding SetFilterCommand}" CommandParameter="Streamed"
                                    Padding="9,3" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="&#x2601; Space saver" Command="{Binding SetFilterCommand}" CommandParameter="Offload"
                                    Padding="9,3" FontSize="11" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Kind of file: all, or one group (the list below is grouped the same way). -->
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton GroupName="TransferKind" IsChecked="True" Content="All types" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="All" />
                        <RadioButton GroupName="TransferKind" Content="Photos" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Photos" />
                        <RadioButton GroupName="TransferKind" Content="Videos" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Videos" />
                        <RadioButton GroupName="TransferKind" Content="Music" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Music" />
                        <RadioButton GroupName="TransferKind" Content="Documents" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Documents" />
                        <RadioButton GroupName="TransferKind" Content="Apps &amp; archives" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Apps &amp; archives" />
                        <RadioButton GroupName="TransferKind" Content="Others" Style="{StaticResource PillRadio}" Height="30" Margin="0,0,6,6"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Others" />
                    </WrapPanel>

                    <!-- Transfer Items List -->
                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                        <!-- One block per kind of file: "Photos · 12", then its transfers. -->
                        <ItemsControl ItemsSource="{Binding TransferGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding Count, StringFormat=' · {0}'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="14" Padding="8,6" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <!-- Action Buttons on Right -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Button Content="Open" Command="{Binding OpenFileCommand}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0" ToolTip="Open file with default app" />
                                                <Button Content="Folder" Command="{Binding OpenFolderCommand}" Padding="8,3" FontSize="10.5" ToolTip="Show file in Windows Explorer" />
                                            </StackPanel>

                                            <!-- Direction Badge on Left -->
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource Bg}" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DirectionIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding DirectionTone, Converter={StaticResource Tone}}" />
                                            </Border>

                                            <!-- Details in Middle -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource Dim}" Margin="0,2,0,0">
                                                    <Run Text="{Binding DirectionBadge, Mode=OneWay}" Foreground="{Binding DirectionTone, Converter={StaticResource Tone}, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" &#183; " />
                                                    <Run Text="{Binding SizeFormatted, Mode=OneWay}" />
                                                    <Run Text=" &#183; &#9889; " />
                                                    <Run Text="{Binding SpeedFormatted, Mode=OneWay}" Foreground="{DynamicResource Accent}" />
                                                    <Run Text=" &#183; " />
                                                    <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                                    <Run Text=" &#183; " />
                                                    <Run Text="{Binding TimeFormatted, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <TextBlock Text="No transfers recorded yet. Transfer files from phone to see history here."
                               Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Visibility="{Binding HasTransfers, Converter={StaticResource NotVis}}" />
                </StackPanel>
            </Border>

            <!-- 4. Send to Phone: quick drop zone -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Purple}" BorderThickness="1"
                    AllowDrop="True" Drop="OnDropZoneDrop"
                    Visibility="{Binding IsChecked, ElementName=TabSend, Converter={StaticResource Vis}}">
                <StackPanel Margin="10,40" HorizontalAlignment="Center">
                    <TextBlock Text="📁 PC TO PHONE QUICK DROP ZONE" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Purple}" />
                    <TextBlock Text="Drag and drop files, ROMs, or videos here to push them to your connected phone over local Wi-Fi at 50-100 MB/s."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 5. Storage Saver: move received files to the cloud drive -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabStorage, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="STORAGE SAVER" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding StorageSaverSummary}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="⚡ Free Up Space Now" Command="{Binding OffloadToCloudNowCommand}" Style="{StaticResource Primary}" Padding="12,6" Margin="0,0,8,0"
                                ToolTip="Move files received from the phone to the cloud drive right now" />
                        <Button Content="Open Uploads Folder" Command="{Binding OpenUploadsFolderCommand}" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 6. Permissions: what a paired phone may do -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabPermissions, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="ACCESS PERMISSIONS" Style="{StaticResource Label}" Margin="0,0,0,10" />
                    <CheckBox Content="Allow Browsing Cloud Drive Virtual Drives" IsChecked="{Binding AllowDriveBrowsing}" Margin="0,0,0,8" />
                    <CheckBox Content="Allow Media Streaming (4K Video &amp; Music)" IsChecked="{Binding AllowStreaming}" Margin="0,0,0,8" />
                    <CheckBox Content="Allow Mobile-to-PC File Uploads (Send to PC, camera backup)" IsChecked="{Binding AllowUploads}" Margin="0,0,0,8" />
                    <CheckBox Content="Allow File Management on the Cloud Drives (new folder, rename, move, delete, camera backup)" IsChecked="{Binding AllowFileManagement}" Margin="0,0,0,8" />
                    <CheckBox Content="Enable Live Gaming HUD on Phone Screen" IsChecked="{Binding AllowGamingHud}" Margin="0,0,0,8" />
                    <CheckBox Content="Allow PC Control (connect/disconnect drives, free up space, open files on this screen, restore game saves)" IsChecked="{Binding AllowPcControl}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding AllowPcDisks}" Margin="0,0,0,4">
                        <TextBlock Text="Share this PC's own disks (C:, D:…) with paired phones — not only the cloud drives" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Off by default: a paired phone then sees only the cloud drives and the folders phone files are saved in."
                               Style="{StaticResource Caption}" Margin="22,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="AWAY FROM HOME (TAILSCALE)" Style="{StaticResource Label}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Set up away-from-home" Command="{Binding SetUpAwayCommand}" Style="{StaticResource Primary}" Padding="12,6"
                                ToolTip="Installs Tailscale if needed, opens its sign-in, then lets phones in and adds the firewall rule" />
                        <TextBlock Text="{Binding AwaySetupText}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="460" />
                    </StackPanel>
                    <CheckBox Content="Let paired phones reach this PC through Tailscale (mobile data, other Wi-Fi)" IsChecked="{Binding AllowTailscale}" Margin="0,0,0,6" />
                    <CheckBox Content="Turn it on by itself when Tailscale is signed in on this PC" IsChecked="{Binding TailscaleAuto}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding TailscaleText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,0,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,0,0,8"
                               Text="Pairing always happens at home on the same Wi-Fi. The button above adds the firewall rule; if it was refused, run this command once in an administrator terminal." />
                    <DockPanel Margin="22,0,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyFirewallCommandCommand}" Padding="10,3" Margin="8,0,0,0" />
                        <TextBox Text="{Binding FirewallCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="10.5" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 7. Folders: where files from the phone are saved -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TabFolders, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="FOLDER CONFIGURATION FOR PHONE SYNC" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <TextBlock Text="PHONE UPLOAD DESTINATION DIRECTORY" Style="{StaticResource Label}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseUploadsCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding UploadDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Text="PHONE PHOTOS AUTO-BACKUP DIRECTORY" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowsePhotosCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding PhotosBackupDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
