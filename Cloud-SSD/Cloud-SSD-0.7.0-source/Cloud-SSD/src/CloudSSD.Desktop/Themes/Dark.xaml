<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark palette. Light.xaml defines exactly the same keys; ThemeManager swaps one for the other at run time, and
        every view refers to these brushes with DynamicResource so the switch is instant.
    -->
    <Color x:Key="BgColor">#0A0C10</Color>
    <Color x:Key="SurfaceColor">#12151B</Color>
    <Color x:Key="Surface2Color">#181C24</Color>
    <Color x:Key="Surface3Color">#20252F</Color>
    <Color x:Key="BorderColor">#262C37</Color>
    <Color x:Key="TextColor">#E7EAF0</Color>
    <Color x:Key="MutedColor">#8B94A5</Color>
    <Color x:Key="DimColor">#5D6677</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#5B9BFF</Color>
    <Color x:Key="AccentPressedColor">#2F6FD6</Color>
    <!-- One colour: "purple" is the same blue (the A+C look). -->
    <Color x:Key="PurpleColor">#3B82F6</Color>
    <Color x:Key="SuccessColor">#3B82F6</Color>
    <Color x:Key="WarningColor">#E0A33A</Color>
    <Color x:Key="DangerColor">#EF5350</Color>
    <Color x:Key="GridLineColor">#28FFFFFF</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#263B82F6" />
    <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="PurpleSoft" Color="#263B82F6" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="GridLine" Color="{StaticResource GridLineColor}" />
    <!-- Text on the blue band and on blue buttons; the band a deeper blue so white text reads on it. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnAccentMuted" Color="#C9D8FB" />
    <SolidColorBrush x:Key="BandBrush" Color="#1D4ED8" />
</ResourceDictionary>
